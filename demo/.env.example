# copy to demo/.env — never commit secrets
# Any OpenAI-compatible Chat Completions key. DeepSeek is optional.

# CIVIL_API_KEY=
# CIVIL_API_BASE=https://api.openai.com/v1
# CIVIL_MODEL=gpt-4o-mini

# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek V4.1 Flash uses the canonical API ID below.
# DEEPSEEK_MODEL=deepseek-flash

# --- 手机 / 局域网访问（可选，python serve.py 读这里） ---
# 0.0.0.0 让同一 Wi-Fi 下的手机打开 http://<本机IP>:8765
# CIVIL_HOST=127.0.0.1
# CIVIL_PORT=8765
# 开给局域网时必设：/api/* 要带这个口令（页面第一次会问一次，存 cookie；脚本用 Authorization: Bearer）
# CIVIL_TOKEN=
# 上游模型两段输出之间最长等多久（秒）；连接超时另有 CIVIL_LLM_CONNECT_TIMEOUT（默认 15）
# CIVIL_LLM_READ_TIMEOUT=180
# CIVIL_JOB_ROOT=

# packing-agent sidecar (pick one)
# PACKING_AGENT_URL=http://127.0.0.1:8000
# PACKING_AGENT_ROOT=E:\REDACTED-PATH
